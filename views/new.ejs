<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuevo Personaje</title>
    <base href="/">
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <h1>Nuevo Personaje</h1>
    <form action="/starwars" method="POST">
        <label>
            Nombre
            <input type="text" name="name" autofocus required>
        </label>
        <label>
            Altura
            <input type="text" name="height" required>
        </label>
        <label>
            Peso
            <input type="text" name="mass" required>
        </label>
        <label>
            Foto (URL)
            <input type="url" name="photo" required>
        </label>
        <button type="submit">Crear</button>
        <a href="/starwars"><button type="button">Cancelar</button></a>
    </form>
</body>
</html>